{
  "comments": {
    "Game": "Beyond These Stars"
  },

  "pipeline": {
    "registry": {
      "mode": "guid_index",
      "indices": [
        "Assets\\Assets\\Definitions\\AlienTechnology",
        "Assets\\Assets\\Definitions\\Animals",
        "Assets\\Assets\\Definitions\\Buildings",
        "Assets\\Assets\\Definitions\\Events",
        "Assets\\Assets\\Definitions\\Galaxies",
        "Assets\\Assets\\Definitions\\Perks",
        "Assets\\Assets\\Definitions\\Recipes",
        "Assets\\Assets\\Definitions\\ResourceDefinitions",
        "Assets\\Assets\\Definitions\\ResourceGroups",
        "Assets\\Assets\\Definitions\\Seeds",
        "Assets\\Assets\\Definitions\\Spaceships",
        "Assets\\Assets\\Definitions\\Vehicles"
      ]
    },
    "domain_data": {
      "ref_type": "name"
    },
    "strings": {
      "source": "i2",
      "path": "Assets/Resources/I2Languages.asset"
    }
  },



  "deduplication": [],



  "global_rename": {
    "ResourceDefinitions": "Resources",
    "RegionGenerationData": "RegionGenData",
    "SpaceEntityGenerationData": "SpaceEntityGenData"
  },



  "all_domains": {
    "strings": {
      "key_suffix": "Term"
    },
    "exclude": [
      "PrefabAddresses",
      "UnlockTerm"
    ],
    "expand": {}
  },
  


  "Buildings": {
    "exclude": [
      "ConstructionSiteModel",
      "PeepWorkTool",
      "PeepCarryTool",
      "PeepFetchOverrideTool",
      "WorkerPathingType",
      "DefaultWorkPanel",
      "AlternateWorkPanel",
      "ExtraWorkPanel",
      "ExtraWorkPanels",
      "OverrideDamagedSound",
      "VehicleSpawnTileAxialCoordinate",
      "SelectionSound",
      "OperatingSound",
      "DisplayRules",
      "BuildingTiles",
      "BuildingEntryWayPointData",
      "AlertsToIgnoreHash",
      "ValidTileTypes",
      "WorkerPositions",
      "AlertsToIgnore",
      "ShowInUI",
      "ShowInputsOnTaskButton",
      "IgnorePeepWorkDelta",
      "ShowActiveToggle"
    ],
    "expand": {},
    "separate":{
      "BuildingTasks": {
        "domain": "BuildingTasks",
        "guid_prefix": "000745b5"
      }
    }
  },



  "Events": {
    "exclude": [
      "BlockingRecords"
    ]
  },



  "Galaxies": {
    "exclude": [
      "Nodes",
      "EditorColourSerialized"
    ],
    "expand": {},
    "separate": {
      "RegionGenerationData": {
        "domain": "SectorRegionGenerationData",
        "guid_prefix": "005ec704"
      }
    }
  },



  "ResourceDefinitions": {
    "exclude": [
      "OverlayColour",
      "FetchTraySound",
      "FetchWheelbarrowSound",
      "DisplayType",
      "PlantPrefabName"
    ]
  },



  "Spaceships": {
    "exclude": [
      "TakeOffTime",
      "TakeOffAnimationTransitionDistance",
      "TakeOffDistance",
      "LandingTouchDownTime",
      "LandingAnimationTransitionDistance",
      "LandingApproachDistance"
    ]
  }
}